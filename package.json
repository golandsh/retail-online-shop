{
  "name": "retail-online-shop-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "docker:up": "docker compose -f online-shop-firebase-local/docker-compose.yml up -d",
    "docker:down": "docker compose -f online-shop-firebase-local/docker-compose.yml down",
    "docker:restart": "docker restart online-shop-firebase-local",
    "docker:build": "docker compose -f online-shop-firebase-local/docker-compose.yml build",
    "firebase:login": "firebase login",
    "deploy": "firebase deploy",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:qa": "pnpm build && firebase deploy"
  },
  "devDependencies": {
    "firebase-tools": "^13.31.1",
    "turbo": "^2.0.4"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.8.0"
  }
}