{
  "name": "retail-online-shop-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "docker:up": "docker compose -f online-shop-firebase-local/docker-compose.yml up -d",
    "docker:down": "docker compose -f online-shop-firebase-local/docker-compose.yml down",
    "docker:build": "docker compose -f online-shop-firebase-local/docker-compose.yml build"
  },
  "devDependencies": {
    "turbo": "^2.0.4"
  }
}
