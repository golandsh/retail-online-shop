{
  "functions": [
    {
      "source": "backend/services/grocery-import",
      "codebase": "grocery-import",
      "runtime": "nodejs22",
      "predeploy": [
        "pnpm --prefix \"$RESOURCE_DIR\" run build"
      ]
    },
    {
      "source": "backend/services/grocery-api",
      "codebase": "grocery-api",
      "runtime": "nodejs22",
      "predeploy": [
        "pnpm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "online-shop-firebase-local/storage.rules"
  },
  "firestore": {
    "rules": "online-shop-firebase-local/firestore.rules"
  }
}
