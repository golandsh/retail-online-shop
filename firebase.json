{
  "functions": [
    {
      "source": "backend/services/grocery-import",
      "codebase": "grocery-import",
      "runtime": "nodejs22",
      "predeploy": [
        "pnpm --prefix \"$RESOURCE_DIR\" run build"
      ]
    },
    {
      "source": "backend/services/grocery-api",
      "codebase": "grocery-api",
      "runtime": "nodejs22",
      "predeploy": [
        "pnpm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "online-shop-firebase-local/storage.rules"
  },
  "firestore": {
    "rules": "online-shop-firebase-local/firestore.rules"
  },
  "hosting": [
    {
      "target": "orders",
      "public": "frontend/orders/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/getCatalog",
          "function": {
            "functionId": "getCatalog",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/createOrder",
          "function": {
            "functionId": "createOrder",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/upsertUser",
          "function": {
            "functionId": "upsertUser",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/upsertAddress",
          "function": {
            "functionId": "upsertAddress",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/deleteAddress",
          "function": {
            "functionId": "deleteAddress",
            "region": "us-east1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "admin",
      "public": "frontend/admin/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
