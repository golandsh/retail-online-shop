{
    "name": "grocery-import",
    "version": "1.0.0",
    "description": "This repo will be used to Import data into Grocery Delivery System",
    "main": "lib/index.js",
    "scripts": {
        "build": "tsc",
        "dev": "pnpm serve",
        "serve": "pnpm build && node scripts/run-firebase-emulator.js",
        "shell": "pnpm build && firebase functions:shell",
        "deploy": "pnpm build && firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test": "vitest run",
        "lint": "tsc --noEmit",
        "clean": "rimraf lib node_modules"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mosheProj/Grocery-ImporterApi.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "engines": {
        "node": "22"
    },
    "bugs": {
        "url": "https://github.com/mosheProj/Grocery-ImporterApi/issues"
    },
    "homepage": "https://github.com/mosheProj/Grocery-ImporterApi#readme",
    "dependencies": {
        "csv-parse": "^7.0.0",
        "dotenv": "^17.4.2",
        "firebase-admin": "^13.10.0",
        "firebase-functions": "^7.2.5",
        "nodemailer": "^9.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "@types/nodemailer": "^8.0.1",
        "firebase-tools": "^15.22.3",
        "rimraf": "^6.0.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    }
}